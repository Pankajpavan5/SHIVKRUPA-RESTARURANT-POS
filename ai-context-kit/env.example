# Rename this file to .env.example and commit it.
# Copy it to .env for real values. Never commit .env.
#
# Purpose: the AI needs to know which env vars exist without seeing secrets.

# =====================================================================
# NOTE FOR QUICK POS
# =====================================================================
# This project deliberately has ZERO environment variables.
#
# It is a single static HTML file. No backend, no build step, no API
# keys, no analytics, no cloud services. Everything the app knows lives
# in the user's browser localStorage.
#
# This file exists only so future contributors don't wonder "where's
# the .env?". The answer is: there isn't one, on purpose.
#
# See DECISIONS.md → "Single HTML file, no build step, no dependencies"
# and "Local storage only, no backend".
# =====================================================================


# --- Runtime config (baked into index.html, not env-driven) ---
# LS_KEY=quickpos_v5              # localStorage namespace; bump on breaking schema change
# DEFAULT_COUNTRY_CODE=91         # editable per-shop in Settings → Shop Details
# DEFAULT_TAX_PCT=5               # editable per-shop in Settings → Shop Details
# IMAGE_MAX_EDGE_PX=240           # resizeImage() target; hardcoded
# IMAGE_JPEG_QUALITY=0.75         # resizeImage() quality; hardcoded
# BILL_HISTORY_CAP=500            # closeTable() trims older; hardcoded


# --- If we ever add a backend (v2+), it would go here ---
# API_BASE_URL=
# API_KEY=
# SYNC_ENABLED=false
